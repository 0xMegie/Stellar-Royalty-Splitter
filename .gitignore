# Rust
/target
*.wasm

# Node
frontend/node_modules
backend/node_modules
shared/node_modules

# Test coverage output
backend/coverage
frontend/coverage
frontend/coverage-report
Cargo-llvm-cov-target
lcov.info

# Env
# Real env files are never committed. Only the *.example templates under
# config/env/ are tracked — they hold placeholders only.
.env
.env.*
!.env.example
!*.example
backend/.env
frontend/.env
config/env/.env.dev
config/env/.env.staging
config/env/.env.prod

# Deployed contract ID
.contract-id
